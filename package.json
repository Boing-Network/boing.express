{
  "name": "boing-wallet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "pnpm": ">=9 <10"
  },
  "type": "module",
  "scripts": {
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "prebuild": "node scripts/generate-brand-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "node scripts/clean-extension-build.js && node scripts/generate-extension-manifest.js && node scripts/generate-extension-icons.js && vite build --config vite.extension.config.ts && vite build --config vite.extension.inpage.config.ts",
    "copy:extension:unpacked": "node scripts/copy-extension-unpacked.js",
    "build:extension:unpacked": "pnpm run build:extension && pnpm run copy:extension:unpacked",
    "zip:extension": "node scripts/zip-extension.js",
    "publish:extension": "node scripts/publish-extension.js",
    "prepare:extension": "node scripts/prepare-extension-for-load.js",
    "build:extension:load": "pnpm run build:extension && pnpm run prepare:extension",
    "test": "vitest run",
    "test:e2e": "pnpm run build:extension && playwright test",
    "test:e2e:web": "pnpm build && playwright test -c playwright.web.config.ts",
    "test:e2e:multi": "pnpm run build:extension && playwright test tests/e2e/extension-multi-account.spec.ts",
    "preview": "vite preview",
    "pages:deploy": "pnpm build && wrangler pages deploy dist --project-name=boing-wallet",
    "pages:dev": "vite",
    "gateway:dev": "wrangler dev --config workers/rpc-gateway/wrangler.toml",
    "gateway:deploy": "wrangler deploy --config workers/rpc-gateway/wrangler.toml"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.0.1",
    "boing-sdk": "github:Boing-Network/boing.network#672448e0130d2b06e0fd9823f0fd69a8baf16254&path:/boing-sdk",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "chrome-webstore-upload-cli": "^3.5.0",
    "sharp": "^0.35.5",
    "typescript": "~5.6.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.0"
  },
  "pnpm": {
    "overrides": {
      "undici@7": "^7.29.1",
      "ws@8": "^8.21.0",
      "sharp": "^0.35.5",
      "rollup@4": "^4.59.0",
      "postcss@8": "^8.5.23",
      "nanoid@3": "^3.3.12",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@babel/core": "^7.29.6"
    }
  }
}
